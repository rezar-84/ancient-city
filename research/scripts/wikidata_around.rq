SELECT ?item ?itemLabel ?trLabel ?coord ?enwiki ?commonscat WHERE {
  SERVICE wikibase:around { ?item wdt:P625 ?coord . bd:serviceParam wikibase:center "Point(29.125 37.927)"^^geo:wktLiteral . bd:serviceParam wikibase:radius "2.5" . }
  OPTIONAL { ?item rdfs:label ?trLabel FILTER(lang(?trLabel)="tr") }
  OPTIONAL { ?enwiki schema:about ?item ; schema:isPartOf <https://en.wikipedia.org/> }
  OPTIONAL { ?item wdt:P373 ?commonscat }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
